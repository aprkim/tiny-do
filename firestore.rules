rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── tinyWins (tiny-do and friends) ─────────────────────────────────────
    // Data is addressed by sync code, which acts as a shared key for
    // cross-device access. The code IS the secret, so the rules must make
    // sure codes cannot be discovered.
    //
    // Deliberately `get` and not `read`: in Firestore, `read` means
    // `get` + `list`, and granting `list` here let any anonymous user run
    // db.collection('tinyWins').get() and receive every document — with the
    // sync codes as the document IDs. `get` still allows the only access
    // pattern the apps use, collection('tinyWins').doc(syncCode).
    match /tinyWins/{syncCode} {
      allow get, write: if request.auth != null;
    }

    // ── Tiny Cards ─────────────────────────────────────────────────────────
    // Multi-tenant: each signed-in user owns their OWN archive at
    // tinyCards/{uid}, keyed by their auth uid. A user can only touch the
    // document whose id equals their uid, so no one can read or write another
    // person's cards. Everyone must have a verified email.
    //
    // This replaced the single shared "family" space + email allowlist.
    // Cross-user sharing (invites/viewers) is deferred to a later phase.
    //
    // `get` not `read`: no `list`, so the collection can't be enumerated.
    //
    // NOTE: Firestore rules are project-wide, so this file is the single
    // source of truth for tiny-wins25 and is deployed from the tiny-do repo.
    function cardsVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /tinyCards/{uid} {
      allow get, write: if cardsVerified() && request.auth.uid == uid;
    }

    // Reserved for future cross-user sharing; clients get nothing for now.
    match /invites/{code} {
      allow read, write: if false;
    }
    match /cardViewers/{uid} {
      allow read, write: if false;
    }
  }
}
