rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── tinyWins (tiny-do and friends) ─────────────────────────────────────
    // Data is addressed by sync code, which acts as a shared key for
    // cross-device access. The code IS the secret, so the rules must make
    // sure codes cannot be discovered.
    //
    // Deliberately `get` and not `read`: in Firestore, `read` means
    // `get` + `list`, and granting `list` here let any anonymous user run
    // db.collection('tinyWins').get() and receive every document — with the
    // sync codes as the document IDs. That handed out every space's data,
    // and `write` meant they could overwrite it too.
    //
    // `get` still allows the only access pattern the apps actually use,
    // collection('tinyWins').doc(syncCode), while collection-wide queries
    // are now denied. These apps sign in anonymously, so no email checks
    // can apply here.
    match /tinyWins/{syncCode} {
      allow get, write: if request.auth != null;
    }

    // ── Tiny Cards ─────────────────────────────────────────────────────────
    // One shared family space with an email allowlist: the owner can read
    // and write, named viewers can only read. Everyone must have a verified
    // email — an anonymous or unverified session gets nothing.
    //
    // This replaced uid-keyed documents. Keying by uid made viewer access
    // impossible: a viewer's uid points at their own (empty) document, not
    // the owner's. The space id in the path is shared instead, and identity
    // is judged by email, which is what the humans involved actually have.
    //
    // NOTE: Firestore rules are project-wide, so this file is the single
    // source of truth for tiny-wins25 and is deployed from the tiny-do repo.
    function cardsVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function cardsOwner() {
      return cardsVerified() && request.auth.token.email == 'aprkim@gmail.com';
    }
    function cardsViewer() {
      // Read-only family members. Add their Google account emails here and
      // to the matching list in tiny-cards/storage.rules.
      return cardsVerified() && request.auth.token.email in [
        'viewer-one-not-yet-set@invalid.example',
        'viewer-two-not-yet-set@invalid.example'
      ];
    }
    match /tinyCards/{space} {
      allow get: if cardsOwner() || cardsViewer();
      allow write: if cardsOwner();
    }
  }
}
