rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── tinyWins (tiny-do and friends) ─────────────────────────────────────
    // Data is addressed by sync code (a shared secret). `get` not `read` so the
    // collection can't be enumerated to discover codes.
    match /tinyWins/{syncCode} {
      allow get, write: if request.auth != null;
    }

    // ── Tiny Cards ─────────────────────────────────────────────────────────
    // Multi-tenant: each signed-in user owns tinyCards/{uid}. A user can always
    // read+write their own space. They can additionally READ another user's
    // space if that owner's uid is in their `viewOf` custom claim (granted when an
    // invited email signs in; see the Cloud Functions). Viewers are read-only —
    // only the owner can write. Everyone must have a verified email.
    //
    // Firestore rules are project-wide; this file is the source of truth for
    // tiny-wins25 and deploys from the tiny-do repo. Keep the viewOf check in
    // step with tiny-cards/storage.rules.
    function cardsVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function canView(uid) {
      return request.auth.uid == uid
        || (request.auth.token.viewOf != null && request.auth.token.viewOf.hasAny([uid]));
    }
    // Free archives hold 20 cards; Kept Unlimited lifts the ceiling. The limit
    // lives here because the client writes the whole cards array itself — there
    // is no function in between to count them, and a check in the app would be
    // a suggestion rather than a limit.
    //
    // Only GROWING the archive is restricted. Someone already past 20 — an
    // early user, or a subscriber who let it lapse — keeps full use of what they
    // have: renaming, deleting, editing a transcript and exporting all still
    // work. Losing access to your own keepsakes because you stopped paying
    // would be indefensible.
    function cardCount(d) {
      return d.get('cards', []).size();
    }
    // isUnlimited is the live subscription; unlimitedGrant is permanent — the
    // people who used Kept before the limit existed, and comped accounts — and
    // survives a lapse, so the store can never take it back. Either counts.
    function plan(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function cardsUnlimited(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && (plan(uid).get('isUnlimited', false) == true
            || plan(uid).get('unlimitedGrant', false) == true);
    }
    match /tinyCards/{uid} {
      allow get:    if cardsVerified() && canView(uid);
      allow create: if cardsVerified() && request.auth.uid == uid
                    && (cardCount(request.resource.data) <= 20 || cardsUnlimited(uid));
      allow update: if cardsVerified() && request.auth.uid == uid
                    && (cardCount(request.resource.data) <= 20
                        || cardCount(request.resource.data) <= cardCount(resource.data)
                        || cardsUnlimited(uid));
      allow delete: if cardsVerified() && request.auth.uid == uid;
    }

    // Sharing-by-email records (written only by the invite/sync/revoke functions):
    //  • viewerInvites/{ownerUid}/emails/{emailKey} — the owner's list of who they
    //    shared with (email + invited/active status); owner reads it to manage.
    //  • sharedWithMe/{viewerUid}/spaces/{ownerUid} — the viewer's list of spaces
    //    shared with them (viewer reads it for the space switcher).
    //  • emailGrants/{emailKey}/owners/{ownerUid} — reverse index used to grant the
    //    claim on sign-in; server-only, never client-readable.
    match /viewerInvites/{ownerUid}/emails/{emailKey} {
      allow read:  if request.auth != null && request.auth.uid == ownerUid;
      allow write: if false;
    }
    match /sharedWithMe/{viewerUid}/spaces/{ownerUid} {
      allow read:  if request.auth != null && request.auth.uid == viewerUid;
      allow write: if false;
    }
    match /emailGrants/{emailKey}/owners/{ownerUid} {
      allow read, write: if false;
    }

    // Transcription usage counter — written only by the transcribeCard function
    // (Admin SDK bypasses rules). Clients never read or write it.
    match /transcriptions/{uid} {
      allow read, write: if false;
    }

    // ── TinyRoom (room2.tinywins.space) usage log ───────────────────────────
    // Written only by the livekitWebhook function and read only by the
    // passcode-gated tinyroomStats function (both Admin SDK). No client access.
    match /tinyroomSessions/{sid} {
      allow read, write: if false;
    }
    match /tinyroomRooms/{sid} {
      allow read, write: if false;
    }

    // ── Accounts (Kept) ─────────────────────────────────────────────────────
    // users/{uid}.isUnlimited is the subscription, and the only thing the app
    // and the rule above trust. Written solely by the server — syncSharedAccess
    // creates it free, revenuecatWebhook flips it — so a client cannot grant
    // itself the entitlement. Readable by its owner so the app can show the
    // right state without a round trip.
    match /users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
